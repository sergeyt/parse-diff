{
  "name": "parse-diff",
  "version": "0.13.0",
  "description": "Unified diff parser",
  "author": "Sergey Todyshev <stodyshev@gmail.com>",
  "main": "index.js",
  "types": "index.d.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git@github.com:sergeyt/parse-diff.git"
  },
  "keywords": [
    "diff",
    "unidiff",
    "parser"
  ],
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "esbuild": "^0.28.2",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  },
  "scripts": {
    "lint:fix": "biome check --write .",
    "lint": "biome check .",
    "typecheck": "tsc --noEmit",
    "build:js": "esbuild index.ts --minify --format=cjs --platform=node --outfile=index.js",
    "build:types": "tsc",
    "build": "npm run build:js && npm run build:types",
    "pretest": "npm run build",
    "test": "jest",
    "ci": "npm run lint && npm run typecheck && npm test"
  }
}
